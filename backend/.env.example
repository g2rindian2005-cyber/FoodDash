# ------------------------------------------------------------------
# Backend environment variables
# Copy this file to ".env" and fill in real values before running.
#   cp .env.example .env
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (comma separated for multiple).
# In production set this to your EC2 public IP / domain, e.g. http://13.234.x.x
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection
PGHOST=database-1.caxycia26f48.us-east-1.rds.amazonaws.com
PGPORT=5432
PGUSER=fooduser
PGPASSWORD=9356782322
PGDATABASE=fooddb
PGSSLMODE=require

# JSON Web Token secret — CHANGE THIS to a long random string in production
JWT_SECRET=931768e38590aae6a842e1de65d23c2a1a2e6e17bc2b20fe6005cbc9a133d352
JWT_EXPIRES_IN=7d

# "Scan to Pay" UPI QR code (demo only — no real gateway is wired up)
UPI_MERCHANT_VPA=fooddash@upi
UPI_MERCHANT_NAME=FoodDash
