# ------------------------------------------------------------------
# Backend environment variables
# Copy this file to ".env" and fill in real values before running.
#   cp .env.example .env
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (comma separated for multiple).
# In production set this to your EC2 public IP / domain, e.g. http://13.234.x.x
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=fooduser
PGPASSWORD=foodpass
PGDATABASE=fooddb
PGSSLMODE=require

# JSON Web Token secret — CHANGE THIS to a long random string in production
JWT_SECRET=super_secret_change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# "Scan to Pay" UPI QR code (demo only — no real gateway is wired up)
UPI_MERCHANT_VPA=fooddash@upi
UPI_MERCHANT_NAME=FoodDash
